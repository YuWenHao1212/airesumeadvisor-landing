{
  "redirects": [
    {
      "source": "/blog/resume-diagnosis-2026-zh",
      "destination": "/zh-TW/blog/resume-diagnosis-2026",
      "type": 301
    },
    {
      "source": "/blog/best-jobscan-alternatives-2026-zh",
      "destination": "/zh-TW/blog/best-jobscan-alternatives-2026",
