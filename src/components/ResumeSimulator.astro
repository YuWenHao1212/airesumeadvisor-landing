---
import { LINKS } from '../config/links';

const features = [
  { icon: '✨', text: 'AI rewrites your resume to match the job' },
  { icon: '✏️', text: 'Make your own edits anytime' },
  { icon: '📊', text: 'Real-time score updates' },
  { icon: '🎯', text: 'Clear before/after comparison' },
];
---

<section class="bg-white py-16 md:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <!-- Content (Left on desktop) -->
      <div class="max-w-lg">
        <h2 class="font-display text-3xl font-bold text-text-primary sm:text-4xl">
          Edit Your Resume. See Your Score Move.
        </h2>

        <p class="mt-6 text-lg leading-relaxed text-text-body">
          See how your resume matches any job — edit and watch your score change.
        </p>

        <!-- Features List -->
        <ul class="mt-8 space-y-4">
          {
            features.map((feature) => (
              <li class="flex items-center gap-3">
                <span class="text-xl">{feature.icon}</span>
                <span class="text-text-body">{feature.text}</span>
              </li>
            ))
          }
        </ul>

        <!-- CTA Button -->
        <a
          href={LINKS.getStarted}
          data-cta-link="signup"
          class="mt-8 inline-flex items-center gap-2 font-medium text-primary transition-colors hover:text-primary-hover"
        >
          Get Started
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
      </div>

      <!-- Image (Right on desktop) -->
      <div class="relative">
        <!-- Placeholder for Alignment Lab screenshot -->
        <div
          class="aspect-[4/3] w-full overflow-hidden rounded-2xl bg-gradient-to-br from-gray-100 to-gray-200 shadow-2xl"
        >
          <div class="flex h-full flex-col items-center justify-center p-6">
            <!-- 3-column comparison mockup -->
            <div class="w-full rounded-lg border border-gray-300 bg-white p-4 shadow-lg">
              <div class="mb-4 flex items-center justify-between">
                <span class="text-sm font-medium text-gray-700">Alignment Lab</span>
                <div class="flex gap-2">
                  <span
                    class="rounded bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-600"
                  >
                    Original: 62%
                  </span>
                  <span
                    class="rounded bg-primary/10 px-2 py-0.5 text-xs font-medium text-primary"
                  >
                    Tailored: 89%
                  </span>
                </div>
              </div>

              <!-- 3 columns -->
              <div class="grid grid-cols-3 gap-3">
                <!-- Original -->
                <div class="rounded-lg border border-gray-200 bg-gray-50 p-3">
                  <div class="mb-2 text-xs font-medium text-gray-500">Original</div>
                  <div class="space-y-1.5">
                    <div class="h-2 w-full rounded bg-gray-300"></div>
                    <div class="h-2 w-4/5 rounded bg-gray-300"></div>
                    <div class="h-2 w-3/5 rounded bg-gray-300"></div>
                  </div>
                </div>

                <!-- Tailored -->
                <div class="rounded-lg border border-primary/30 bg-primary/5 p-3">
                  <div class="mb-2 text-xs font-medium text-primary">Tailored</div>
                  <div class="space-y-1.5">
                    <div class="h-2 w-full rounded bg-primary/40"></div>
                    <div class="h-2 w-4/5 rounded bg-primary/40"></div>
                    <div class="h-2 w-full rounded bg-primary/40"></div>
                  </div>
                </div>

                <!-- Your Edits -->
                <div class="rounded-lg border border-success/30 bg-success/5 p-3">
                  <div class="mb-2 text-xs font-medium text-success">Your Edits</div>
                  <div class="space-y-1.5">
                    <div class="h-2 w-full rounded bg-success/40"></div>
                    <div class="h-2 w-full rounded bg-success/40"></div>
                    <div class="h-2 w-4/5 rounded bg-success/40"></div>
                  </div>
                </div>
              </div>

              <!-- Score bar -->
              <div class="mt-4 flex items-center gap-3">
                <div class="flex-1 rounded-full bg-gray-200">
                  <div class="h-2 w-[89%] rounded-full bg-gradient-to-r from-primary to-success">
                  </div>
                </div>
                <span class="text-sm font-bold text-success">89%</span>
              </div>
            </div>
            <p class="mt-4 text-sm text-gray-500">Real-time score comparison</p>
          </div>
        </div>

        <!-- Decorative elements -->
        <div class="absolute -right-4 bottom-8 text-lg text-primary/30">+</div>
        <div class="absolute -right-8 top-1/2 text-xl text-alert/30">+</div>
      </div>
    </div>
  </div>
</section>
