---
import { LINKS } from '../config/links';

const features = [
  {
    id: 'alignment',
    tab: 'See Your Match',
    title: 'Know Exactly Where You Stand',
    description:
      'Get your alignment score in seconds—not just keyword matches, but true semantic analysis of how your experience fits the role. See your strengths, gaps, and quick wins at a glance. No more guessing if you\'re qualified. Know before you apply.',
    image: {
      webp: '/images/feature-tab1.webp',
      fallback: '/images/screenshots/feature-tab1.png',
      alt: 'Resume alignment score analysis showing match percentage and skill breakdown',
    },
  },
  {
    id: 'tailored',
    tab: 'Fix & Polish',
    title: 'AI-Powered Resume Rewrite',
    description:
      'Found a presentation gap? Our AI rewrites your resume to better showcase what you already have. See exactly how each section improves with before-and-after scores. Your experience stays real—just presented in the language employers want to see.',
    image: {
      webp: '/images/feature-tab2.webp',
      fallback: '/images/screenshots/feature-tab2-polish.png',
      alt: 'AI-powered resume rewriting interface with before and after comparison',
    },
  },
  {
    id: 'development',
    tab: 'Level Up',
    title: 'Bridge Your Skill Gaps',
    description:
      'Found skills you\'re missing? We\'ll show you exactly which courses and certifications can close the gap—with recommendations tailored to your target role. No more wondering what to learn next.',
    image: {
      webp: '/images/feature-tab3.webp',
      fallback: '/images/screenshots/feature-tab3-levelup.png',
      alt: 'Skill gap analysis with recommended courses and certifications',
    },
  },
];
---

<section id="features" class="bg-background py-16 md:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Section Title -->
    <h2 class="text-center font-display text-3xl font-bold text-text-primary sm:text-4xl md:text-5xl">
      From Analysis to Action
    </h2>

    <!-- Tabs -->
    <div class="mx-auto mt-12 max-w-4xl">
      <div class="flex rounded-xl border border-gray-200 bg-white p-1">
        {features.map((feature, index) => (
          <button
            type="button"
            class="feature-tab flex-1 rounded-lg px-4 py-3 text-center text-sm font-medium transition-all sm:text-base"
            data-tab={feature.id}
            data-active={index === 0 ? 'true' : 'false'}
          >
            {feature.tab}
          </button>
        ))}
      </div>
    </div>

    <!-- Tab Content -->
    <div class="mt-12">
      {features.map((feature, index) => (
        <div
          class="feature-content"
          data-content={feature.id}
          data-visible={index === 0 ? 'true' : 'false'}
        >
          <div class="grid items-start gap-8 lg:grid-cols-2 lg:gap-12">
            <!-- Feature Image -->
            <div class="relative">
              <picture>
                <source srcset={feature.image.webp} type="image/webp" />
                <img
                  src={feature.image.fallback}
                  alt={feature.image.alt}
                  class="w-full rounded-2xl shadow-2xl"
                  width="800"
                  height="500"
                  loading="lazy"
                />
              </picture>

              <!-- Floating Card -->
              <div class="absolute -right-4 top-1/4 z-10 rounded-xl bg-white p-4 shadow-lg sm:-right-8">
                <div class="flex items-center gap-3">
                  <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary-light">
                    <svg class="h-5 w-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                  </div>
                  <div>
                    <p class="text-sm font-medium text-text-primary">83%</p>
                    <p class="text-xs text-text-caption">Content Match</p>
                  </div>
                </div>
              </div>
            </div>

            <!-- Content -->
            <div class="max-w-lg">
              <h3 class="font-display text-2xl font-bold text-text-primary sm:text-3xl">
                {feature.title}
              </h3>
              <p class="mt-4 text-base leading-relaxed text-text-body">
                {feature.description}
              </p>
              <a
                href={LINKS.getStarted}
                class="mt-6 inline-flex items-center gap-2 font-medium text-primary transition-colors hover:text-primary-hover"
              >
                Get Started
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                </svg>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .feature-tab[data-active='true'] {
    @apply bg-primary text-white;
  }

  .feature-tab[data-active='false'] {
    @apply bg-transparent text-text-body hover:bg-gray-50;
  }

  .feature-content[data-visible='false'] {
    @apply hidden;
  }

  .feature-content[data-visible='true'] {
    @apply block;
  }
</style>

<script>
  const tabs = document.querySelectorAll('.feature-tab');
  const contents = document.querySelectorAll('.feature-content');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const targetId = tab.getAttribute('data-tab');

      // Update tabs
      tabs.forEach((t) => t.setAttribute('data-active', 'false'));
      tab.setAttribute('data-active', 'true');

      // Update contents
      contents.forEach((c) => {
        if (c.getAttribute('data-content') === targetId) {
          c.setAttribute('data-visible', 'true');
        } else {
          c.setAttribute('data-visible', 'false');
        }
      });
    });
  });
</script>
