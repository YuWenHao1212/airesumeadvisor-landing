---
import { getLangFromUrl, getLocalizedPath } from '../i18n/utils';
import type { Locale } from '../i18n/types';

interface Props {
  lang?: Locale;
}

const { lang } = Astro.props;
const currentLocale = lang || getLangFromUrl(Astro.url);
const targetLocale: Locale = currentLocale === 'en' ? 'zh-TW' : 'en';
const targetLabel = currentLocale === 'en' ? '中文' : 'EN';

// Build the target URL by switching locale on the current path
const currentPath = Astro.url.pathname;
// Strip existing locale prefix to get the base path
const basePath = currentPath.startsWith('/zh-TW/')
  ? currentPath.replace('/zh-TW/', '/')
  : currentPath.startsWith('/zh-TW')
    ? currentPath.replace('/zh-TW', '/')
    : currentPath;
const targetHref = getLocalizedPath(basePath, targetLocale);
---

<a
  href={targetHref}
  data-umami-event={`lang_switch_to_${targetLocale}`}
  class="inline-flex items-center gap-1.5 rounded-md px-2.5 py-1.5 text-sm font-medium text-text-body transition-colors hover:bg-gray-100 hover:text-text-primary"
  aria-label={currentLocale === 'en' ? 'Switch to Chinese' : 'Switch to English'}
>
  <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"
    ></path>
  </svg>
  {targetLabel}
</a>
