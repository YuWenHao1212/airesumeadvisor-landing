---
import { LINKS } from '../config/links';
import { useTranslations } from '../i18n/utils';
import type { Locale } from '../i18n/types';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);

const plans = [
  {
    name: t('pricing.free.name'),
    price: 0,
    period: t('pricing.free.period'),
    popular: false,
    href: LINKS.signup,
    linkType: 'signup',
    cta: t('pricing.free.cta'),
    highlight: t('pricing.free.highlight'),
    description: t('pricing.free.description'),
    hasReferralDiscount: false,
  },
  {
    name: t('pricing.daily.name'),
    price: 6,
    period: t('pricing.daily.period'),
    popular: false,
    href: LINKS.buyDaily,
    linkType: 'buyDaily',
    cta: t('pricing.daily.cta'),
    highlight: t('pricing.daily.highlight'),
    description: t('pricing.daily.description'),
    hasReferralDiscount: true,
  },
  {
    name: t('pricing.weekly.name'),
    price: 20,
    period: t('pricing.weekly.period'),
    popular: true,
    href: LINKS.buyWeekly,
    linkType: 'buyWeekly',
    cta: t('pricing.weekly.cta'),
    highlight: t('pricing.weekly.highlight'),
    description: t('pricing.weekly.description'),
    hasReferralDiscount: true,
  },
];

const features = [
  t('pricing.feature1'),
  t('pricing.feature2'),
  t('pricing.feature3'),
  t('pricing.feature4'),
  t('pricing.feature5'),
  t('pricing.feature6'),
];
---

<section id="pricing" class="bg-background py-16 md:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Section Title -->
    <h2
      class="text-center font-display text-3xl font-bold text-text-primary sm:text-4xl md:text-5xl"
    >
      {t('pricing.sectionTitle')}
    </h2>
    <p class="mx-auto mt-4 max-w-2xl text-center text-lg text-text-body">
      {t('pricing.sectionDescription')}
    </p>

    <!-- Pricing Cards -->
    <div class="mx-auto mt-12 grid max-w-4xl gap-6 md:grid-cols-3">
      {
        plans.map((plan) => (
          <div
            class={`relative flex flex-col rounded-2xl border bg-white p-6 transition-shadow hover:shadow-lg ${
              plan.popular ? 'border-primary shadow-lg' : 'border-gray-200'
            }`}
          >
            {plan.popular && (
              <span class="absolute -top-3 right-4 rounded-full border border-primary bg-white px-3 py-1 text-xs font-medium text-primary">
                {t('pricing.popular')}
              </span>
            )}

            <!-- Badge area - fixed height for alignment -->
            <div class="mb-3 flex h-7 items-center justify-center">
              {plan.hasReferralDiscount && (
                <div
                  data-referral-badge
                  class="hidden items-center justify-center gap-1.5 rounded-full bg-gradient-to-r from-purple-500 to-indigo-500 px-3 py-1.5 text-xs font-semibold text-white"
                >
                  <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7"
                    />
                  </svg>
                  {t('pricing.discount')}
                </div>
              )}
            </div>

            <div class="flex-grow text-center">
              <p class="text-4xl font-bold text-text-primary">
                {plan.price === 0 ? t('pricing.free') : `$${plan.price}`}
              </p>
              <p class="mt-2 text-lg font-medium text-text-primary">{plan.name}</p>
              <p class="text-sm text-text-caption">{plan.period}</p>
              {plan.description && <p class="mt-2 text-xs text-text-body">{plan.description}</p>}
            </div>

            <div class="mt-auto">
              <a
                href={plan.href}
                data-cta-link={plan.linkType}
                data-umami-event={`pricing_${plan.linkType}_click`}
                class={`mt-6 block w-full rounded-full py-3 text-center font-medium transition-all ${
                  plan.popular
                    ? 'bg-primary text-white hover:bg-primary-hover'
                    : 'border border-gray-200 bg-white text-primary hover:border-primary'
                }`}
              >
                {plan.cta}
              </a>

              <p class="mt-3 h-4 text-center text-xs font-medium text-success">
                {plan.highlight || '\u00A0'}
              </p>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Features -->
    <div class="mx-auto mt-12 max-w-4xl rounded-2xl border border-gray-200 bg-white p-8">
      <h3 class="text-xl font-bold text-text-primary">{t('pricing.featuresTitle')}</h3>

      <div class="mt-6 grid gap-x-8 gap-y-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          features.map((feature) => (
            <div class="flex items-start gap-3">
              <div class="mt-0.5 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-success">
                <svg
                  class="h-3 w-3 text-white"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="3"
                    d="M5 13l4 4L19 7"
                  />
                </svg>
              </div>
              <span class="text-sm leading-tight text-text-body">{feature}</span>
            </div>
          ))
        }
      </div>

      <!-- Free Credits Banner -->
      <div class="mt-6 flex items-center gap-3 rounded-lg bg-primary-light px-4 py-3">
        <div
          class="flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full border border-primary text-primary"
        >
          <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
        <p class="text-sm font-medium text-primary">
          {t('pricing.freeCredits')}
        </p>
      </div>
    </div>
  </div>
</section>
