---
import { LINKS } from '../config/links';

const plans = [
  {
    name: 'Daily Pass',
    price: 10,
    period: '1 Day',
    popular: false,
    href: LINKS.buyDaily,
  },
  {
    name: 'Weekly Pass',
    price: 20,
    period: '7 Days',
    popular: true,
    href: LINKS.buyWeekly,
  },
];

const freeFeatures = [
  'Unlimited alignment assessments',
  'Instant ATS-compatible resume revisions',
  'Personalized recommendations',
  'Course suggestions for missing skills',
  'Before/after comparison',
];
---

<section id="pricing" class="bg-background py-16 md:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Section Title -->
    <h2 class="text-center font-display text-3xl font-bold text-text-primary sm:text-4xl md:text-5xl">
      Pricing
    </h2>

    <!-- Pricing Cards -->
    <div class="mx-auto mt-12 grid max-w-3xl gap-6 md:grid-cols-2">
      {plans.map((plan) => (
        <div
          class={`relative rounded-2xl border bg-white p-8 ${
            plan.popular
              ? 'border-primary shadow-lg'
              : 'border-gray-200'
          }`}
        >
          {plan.popular && (
            <span class="absolute -top-3 right-4 rounded-full border border-primary bg-white px-3 py-1 text-xs font-medium text-primary">
              Popular
            </span>
          )}

          <div class="text-center">
            <p class="text-4xl font-bold text-text-primary">
              ${plan.price}
            </p>
            <p class="mt-2 text-lg font-medium text-text-primary">
              {plan.name}
            </p>
            <p class="text-sm text-text-caption">{plan.period}</p>
          </div>

          <a
            href={plan.href}
            class={`mt-8 block w-full rounded-full py-3 text-center font-medium transition-all ${
              plan.popular
                ? 'bg-primary text-white hover:bg-primary-hover'
                : 'border border-gray-200 bg-white text-primary hover:border-primary'
            }`}
          >
            Buy Now
          </a>
        </div>
      ))}
    </div>

    <!-- Free Features -->
    <div class="mx-auto mt-12 max-w-4xl rounded-2xl border border-gray-200 bg-white p-8">
      <h3 class="text-xl font-bold text-text-primary">Free Features</h3>

      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {freeFeatures.map((feature) => (
          <div class="flex items-center gap-3">
            <div class="flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full bg-success">
              <svg
                class="h-4 w-4 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"
                />
              </svg>
            </div>
            <span class="text-sm text-text-body">{feature}</span>
          </div>
        ))}
      </div>

      <!-- Free Credits Banner -->
      <div class="mt-6 flex items-center gap-3 rounded-lg bg-primary-light px-4 py-3">
        <div class="flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full border border-primary text-primary">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
            />
          </svg>
        </div>
        <p class="text-sm font-medium text-primary">
          Get 10 free credits daily to try all premium features at no cost
        </p>
      </div>
    </div>
  </div>
</section>
