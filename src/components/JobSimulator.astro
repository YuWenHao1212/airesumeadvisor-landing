---
import { LINKS } from '../config/links';
import { useTranslations } from '../i18n/utils';
import type { Locale } from '../i18n/types';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
---

<section class="bg-white py-16 md:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <!-- Content -->
      <div class="max-w-lg">
        <h2 class="font-display text-3xl font-bold text-text-primary sm:text-4xl">
          {t('jobSimulator.title')}
        </h2>

        <p class="mt-6 text-lg leading-relaxed text-text-body">
          {t('jobSimulator.description')}
        </p>

        <!-- User Quote -->
        <blockquote class="mt-6 border-l-4 border-primary pl-4 italic text-text-body">
          {t('jobSimulator.quote')}
        </blockquote>

        <a
          href={LINKS.getStarted}
          class="mt-8 inline-flex items-center gap-2 font-medium text-primary transition-colors hover:text-primary-hover"
        >
          {t('jobSimulator.getStarted')}
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
      </div>

      <!-- Image -->
      <div class="relative">
        <picture>
          <source srcset="/images/skill-tree.webp" type="image/webp" />
          <img
            src="/images/skill-tree.webp"
            alt="Career skill tree showing skill progression and learning paths"
            class="w-full rounded-2xl shadow-2xl"
            width="800"
            height="500"
            loading="lazy"
          />
        </picture>

        <!-- Decorative + symbols -->
        <div class="absolute -right-4 bottom-8 text-lg text-primary/30">+</div>
        <div class="absolute -right-8 top-1/2 text-xl text-alert/30">+</div>
      </div>
    </div>
  </div>
</section>
