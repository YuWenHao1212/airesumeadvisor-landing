---
import { LINKS } from '../config/links';
---

<section class="bg-white py-16 md:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <!-- Content -->
      <div class="max-w-lg">
        <h2 class="font-display text-3xl font-bold text-text-primary sm:text-4xl">
          Your Career Skill Tree
        </h2>

        <p class="mt-6 text-lg leading-relaxed text-text-body">
          Before you invest months in a course, see if it's worth it. Add any skill, certification,
          or project to your resume and watch your alignment score change in real time. Know the ROI
          of every learning decision before you make it.
        </p>

        <!-- User Quote -->
        <blockquote class="mt-6 border-l-4 border-primary pl-4 italic text-text-body">
          "It's like a skill tree in a game, but it's my real career—and now I finally know how to
          level up my life."
        </blockquote>

        <a
          href={LINKS.getStarted}
          class="mt-8 inline-flex items-center gap-2 font-medium text-primary transition-colors hover:text-primary-hover"
        >
          Get Started
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
      </div>

      <!-- Image -->
      <div class="relative">
        <picture>
          <source srcset="/images/skill-tree.webp" type="image/webp" />
          <img
            src="/images/screenshots/skill-tree.png"
            alt="Career skill tree showing skill progression and learning paths"
            class="w-full rounded-2xl shadow-2xl"
            width="800"
            height="500"
            loading="lazy"
          />
        </picture>

        <!-- Floating Card -->
        <div class="absolute -right-4 top-1/4 z-10 rounded-xl bg-white p-4 shadow-lg sm:-right-8">
          <div class="flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary-light">
              <picture>
                <source srcset="/images/logo.webp" type="image/webp" />
                <img
                  src="/images/logo.png"
                  alt="AI Resume Advisor"
                  class="h-6 w-6 object-contain"
                  loading="lazy"
                />
              </picture>
            </div>
            <div>
              <p class="text-xs font-medium text-text-primary">Certificate Added</p>
              <p class="text-xs text-text-caption">+5% Job Score</p>
            </div>
          </div>
        </div>

        <!-- Decorative + symbols -->
        <div class="absolute -right-4 bottom-8 text-lg text-primary/30">+</div>
        <div class="absolute -right-8 top-1/2 text-xl text-alert/30">+</div>
      </div>
    </div>
  </div>
</section>
