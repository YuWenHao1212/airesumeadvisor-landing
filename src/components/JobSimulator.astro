---
import { LINKS } from '../config/links';
---

<section class="bg-white py-16 md:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <!-- Content -->
      <div class="max-w-lg">
        <h2 class="font-display text-3xl font-bold text-text-primary sm:text-4xl">
          Find the Fastest Path to Your Ideal Job with our Job Alignment Simulator
        </h2>

        <p class="mt-6 text-lg leading-relaxed text-text-body">
          Discover which skills matter most for your target role. Add a course, certification, or
          experience to see how your job score improves, guiding your next career move with
          data-driven insight.
        </p>

        <a
          href={LINKS.getStarted}
          class="mt-8 inline-flex items-center gap-2 font-medium text-primary transition-colors hover:text-primary-hover"
        >
          Get Started
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
      </div>

      <!-- Image -->
      <div class="relative">
        <!-- MacBook Mockup -->
        <div class="relative rounded-2xl bg-gray-900 p-2 shadow-2xl">
          <div class="rounded-xl bg-gray-800 p-1">
            <div class="aspect-[16/10] rounded-lg bg-gradient-to-br from-gray-100 to-gray-200 p-4">
              <div class="flex h-full flex-col gap-3">
                <div class="flex items-center gap-2">
                  <div class="h-3 w-3 rounded-full bg-red-400"></div>
                  <div class="h-3 w-3 rounded-full bg-yellow-400"></div>
                  <div class="h-3 w-3 rounded-full bg-green-400"></div>
                </div>
                <div class="flex flex-1 gap-4">
                  <div class="w-1/3 space-y-3">
                    <div class="flex items-center gap-2">
                      <div class="h-6 w-6 rounded bg-primary"></div>
                      <div class="h-3 w-12 rounded bg-gray-300"></div>
                      <div class="ml-auto h-3 w-8 rounded bg-success"></div>
                    </div>
                    <div class="h-3 w-full rounded bg-gray-300"></div>
                    <div class="h-3 w-3/4 rounded bg-gray-300"></div>
                    <div class="mt-4 rounded-lg bg-white p-2 shadow-sm">
                      <div class="h-2 w-full rounded bg-gray-200"></div>
                      <div class="mt-1 h-2 w-2/3 rounded bg-gray-200"></div>
                    </div>
                  </div>
                  <div class="flex-1 rounded-lg bg-white p-3 shadow-sm">
                    <div class="space-y-2">
                      <div class="h-4 w-1/2 rounded bg-gray-200"></div>
                      <div class="h-3 w-full rounded bg-gray-100"></div>
                      <div class="h-3 w-full rounded bg-gray-100"></div>
                      <div class="h-3 w-3/4 rounded bg-gray-100"></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="mx-auto h-4 w-1/3 rounded-b-xl bg-gray-700"></div>
        </div>

        <!-- Floating Card -->
        <div class="absolute -right-4 top-1/4 z-10 rounded-xl bg-white p-4 shadow-lg sm:-right-8">
          <div class="flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary-light">
              <img src="/images/logo.png" alt="AI Resume Advisor" class="h-6 w-6 object-contain" />
            </div>
            <div>
              <p class="text-xs font-medium text-text-primary">Certificate Added</p>
              <p class="text-xs text-text-caption">+5% Job Score</p>
            </div>
          </div>
        </div>

        <!-- Decorative + symbols -->
        <div class="absolute -right-4 bottom-8 text-lg text-primary/30">+</div>
        <div class="absolute -right-8 top-1/2 text-xl text-alert/30">+</div>
      </div>
    </div>
  </div>
</section>
