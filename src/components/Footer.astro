---
import { getLocalizedLink } from '../config/links';
import { useTranslations } from '../i18n/utils';
import type { Locale } from '../i18n/types';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-gray-100 bg-white py-8">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col items-center justify-between gap-4 sm:flex-row">
      <!-- Copyright -->
      <p class="text-sm text-text-body">
        <span class="font-medium text-text-primary">AI Resume Advisor</span>
        {' '}&copy; {currentYear}. {t('footer.copyright')}
      </p>

      <!-- Legal Links -->
      <div class="flex items-center gap-6">
        <a href={getLocalizedLink('/terms', lang)} class="text-sm text-text-body transition-colors hover:text-text-primary">
          {t('footer.terms')}
        </a>
        <a href={getLocalizedLink('/privacy', lang)} class="text-sm text-text-body transition-colors hover:text-text-primary">
          {t('footer.privacy')}
        </a>
      </div>
    </div>
  </div>
</footer>
