---
/**
 * ReferralBanner Component
 *
 * Displays a promotional banner when users arrive via referral link.
 * Shows "You've been invited! Sign up for 20% OFF your first purchase"
 * Hidden by default, shown via JavaScript when referral code is detected.
 */
import { useTranslations } from '../i18n/utils';
import type { Locale } from '../i18n/types';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
---

<div
  id="referral-banner"
  class="hidden bg-gradient-to-r from-purple-600 via-indigo-600 to-purple-700 px-4 py-2.5 text-center"
>
  <div class="mx-auto flex max-w-7xl items-center justify-center gap-2 text-sm text-white">
    <svg class="h-5 w-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7"
      ></path>
    </svg>
    <span>
      <span class="font-semibold">{t('referral.invited')}</span>
      {' '}{t('referral.signUpFor')}{' '}
      <span class="font-bold text-yellow-300">{t('referral.discount')}</span>
      {' '}{t('referral.firstPurchase')}
    </span>
  </div>
</div>
