---
import { LINKS } from '../config/links';

const features = [
  { icon: '⚡', text: 'Instant alignment score while browsing' },
  { icon: '📊', text: 'Section-by-section breakdown' },
  { icon: '🔑', text: 'Keyword match checklist' },
  { icon: '🔗', text: 'One click to full report' },
];
---

<section class="bg-gray-50 py-16 md:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <!-- Image (Left on desktop) -->
      <div class="relative order-2 lg:order-1">
        <div
          class="aspect-[4/3] w-full overflow-hidden rounded-2xl bg-gradient-to-br from-gray-100 to-gray-200 shadow-2xl"
        >
          <img
            src="/images/extension.webp"
            alt="AI Resume Advisor Chrome extension showing job match score on LinkedIn"
            class="h-full w-full object-cover"
            width="800"
            height="500"
            loading="lazy"
          />
        </div>

        <!-- Decorative elements -->
        <div class="absolute -left-4 bottom-8 text-lg text-primary/30">+</div>
        <div class="absolute -left-8 top-1/2 text-xl text-success/30">+</div>
      </div>

      <!-- Content (Right on desktop) -->
      <div class="order-1 max-w-lg lg:order-2">
        <h2 class="font-display text-3xl font-bold text-text-primary sm:text-4xl">
          Screen Jobs in Seconds
        </h2>

        <p class="mt-6 text-lg leading-relaxed text-text-body">
          Browse LinkedIn and know your fit instantly — without leaving the page.
        </p>

        <!-- Features List -->
        <ul class="mt-8 space-y-4">
          {
            features.map((feature) => (
              <li class="flex items-center gap-3">
                <span class="text-xl">{feature.icon}</span>
                <span class="text-text-body">{feature.text}</span>
              </li>
            ))
          }
        </ul>

        <!-- CTA Buttons -->
        <div class="mt-8 flex flex-wrap gap-4">
          <!-- Primary: Add to Chrome (opens in new tab to keep landing page available) -->
          <a
            href="/install-extension"
            target="_blank"
            rel="noopener noreferrer"
            data-cta-link="installExtension"
            class="inline-flex items-center gap-2 rounded-lg bg-primary px-6 py-3 font-medium text-white shadow-lg transition-all hover:bg-primary-hover hover:shadow-xl"
          >
            <!-- Chrome Icon -->
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
              <path
                d="M12 0C8.21 0 4.831 1.757 2.632 4.501l3.953 6.848A5.454 5.454 0 0 1 12 6.545h10.691A12 12 0 0 0 12 0zM1.931 5.47A11.943 11.943 0 0 0 0 12c0 6.012 4.42 10.991 10.189 11.864l3.953-6.847a5.45 5.45 0 0 1-6.865-2.29zm13.342 2.166a5.446 5.446 0 0 1 1.45 7.09l.002.001h-.002l-3.952 6.848a12.014 12.014 0 0 0 9.229-9.006zM12 16.364a4.364 4.364 0 1 1 0-8.728 4.364 4.364 0 0 1 0 8.728z"
              ></path>
            </svg>
            Add to Chrome
          </a>

          <!-- Secondary: Get Started -->
          <a
            href={LINKS.getStarted}
            data-cta-link="signup"
            class="inline-flex items-center gap-2 rounded-lg border border-gray-300 bg-white px-6 py-3 font-medium text-text-primary transition-all hover:border-primary hover:text-primary"
          >
            Get Started
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
