---
import { LINKS } from '../config/links';
import { useTranslations } from '../i18n/utils';
import type { Locale } from '../i18n/types';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
---

<section id="how-it-works" class="bg-background py-16 md:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <!-- Content -->
      <div class="max-w-lg">
        <h2 class="font-display text-3xl font-bold text-text-primary sm:text-4xl">{t('howItWorks.title')}</h2>

        <p class="mt-6 text-lg leading-relaxed text-text-body">
          {t('howItWorks.description')}
        </p>

        <a
          href={LINKS.getStarted}
          class="mt-8 inline-flex items-center gap-2 font-medium text-primary transition-colors hover:text-primary-hover"
        >
          {t('howItWorks.getStarted')}
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
      </div>

      <!-- Video Placeholder -->
      <div class="relative">
        <!-- Browser Window -->
        <div class="overflow-hidden rounded-2xl bg-white shadow-2xl">
          <!-- Browser Header -->
          <div class="flex items-center gap-2 border-b border-gray-100 bg-gray-50 px-4 py-3">
            <div class="flex gap-1.5">
              <div class="h-3 w-3 rounded-full bg-red-400"></div>
              <div class="h-3 w-3 rounded-full bg-yellow-400"></div>
              <div class="h-3 w-3 rounded-full bg-green-400"></div>
            </div>
            <div class="mx-auto flex items-center gap-2 rounded-lg bg-gray-100 px-4 py-1.5">
              <svg
                class="h-3.5 w-3.5 text-gray-400"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
                ></path>
              </svg>
              <span class="text-xs text-gray-500">app.airesumeadvisor.com</span>
            </div>
            <div class="flex gap-2">
              <svg
                class="h-4 w-4 text-gray-400"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M15 19l-7-7 7-7"></path>
              </svg>
              <svg
                class="h-4 w-4 text-gray-400"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"></path>
              </svg>
            </div>
          </div>

          <!-- Video Thumbnail Placeholder -->
          <div class="relative aspect-video bg-gradient-to-br from-gray-200 to-gray-300">
            <!-- Play Button -->
            <button
              type="button"
              class="absolute left-1/2 top-1/2 flex h-16 w-16 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-white/90 shadow-lg transition-transform hover:scale-110"
              aria-label="Play video"
            >
              <svg class="ml-1 h-6 w-6 text-text-primary" fill="currentColor" viewBox="0 0 24 24">
                <path d="M8 5v14l11-7z"></path>
              </svg>
            </button>

            <!-- Placeholder people illustration -->
            <div class="flex h-full items-center justify-center">
              <div class="text-center text-gray-400">
                <svg
                  class="mx-auto h-24 w-24"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1"
                    d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"
                  ></path>
                </svg>
                <p class="mt-2 text-sm">{t('howItWorks.videoComingSoon')}</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Decorative + symbols -->
        <div class="absolute -right-4 top-1/4 text-lg text-primary/30">+</div>
        <div class="absolute -right-8 bottom-1/4 text-xl text-alert/30">+</div>
        <div class="absolute right-1/4 top-0 text-sm text-purple-300">+</div>
      </div>
    </div>
  </div>
</section>
