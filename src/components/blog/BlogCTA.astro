---
import { LINKS } from '../../config/links';
import { useTranslations } from '../../i18n/utils';
import type { Locale } from '../../i18n/types';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
---

<aside class="my-12 rounded-2xl bg-gradient-to-r from-primary via-[#6366F1] to-[#8B5CF6] p-8 text-center sm:p-10">
  <h3 class="font-display text-2xl font-bold text-white sm:text-3xl">
    {t('blog.cta.title')}
  </h3>
  <p class="mx-auto mt-3 max-w-lg text-white/90">
    {t('blog.cta.description')}
  </p>
  <a
    href={LINKS.signup}
    data-cta-link="signup"
    data-umami-event="blog_cta_signup_click"
    class="mt-6 inline-flex items-center gap-2 rounded-lg bg-white px-6 py-3 text-base font-medium text-primary shadow-lg transition-all hover:bg-gray-50 hover:shadow-xl"
  >
    {t('blog.cta.button')}
    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"
      ></path>
    </svg>
  </a>
</aside>
