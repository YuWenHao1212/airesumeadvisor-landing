---
import Layout from '@layouts/Layout.astro';
import ReferralBanner from '../components/ReferralBanner.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ExtensionPromo from '../components/ExtensionPromo.astro';
import Features from '../components/Features.astro';
import ResumeSimulator from '../components/ResumeSimulator.astro';
import JobSimulator from '../components/JobSimulator.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Pricing from '../components/Pricing.astro';
import BottomCTA from '../components/BottomCTA.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="AI Resume Advisor - Know Your Match Before You Apply">
  <ReferralBanner />
  <Header />

  <main>
    <Hero />
    <ExtensionPromo />
    <Features />
    <ResumeSimulator />
    <JobSimulator />
    <HowItWorks />
    <Pricing />
    <BottomCTA />
  </main>

  <Footer />
</Layout>

<script>
  import { initReferralSystem } from '../utils/referral';

  // Initialize referral system when DOM is ready
  document.addEventListener('DOMContentLoaded', initReferralSystem);
</script>
