---
import Layout from '@layouts/Layout.astro';
// Components will be imported as they are created
// import Header from '@components/Header.astro';
// import Hero from '@components/Hero.astro';
// import FeatureTabs from '@components/FeatureTabs.astro';
// import JobSimulator from '@components/JobSimulator.astro';
// import SocialProof from '@components/SocialProof.astro';
// import CTABanner from '@components/CTABanner.astro';
// import HowItWorks from '@components/HowItWorks.astro';
// import Pricing from '@components/Pricing.astro';
// import BottomCTA from '@components/BottomCTA.astro';
// import Footer from '@components/Footer.astro';
---

<Layout title="AI Resume Advisor - Land Your Dream Job with AI-Powered Resumes">
  <main>
    <!-- Header -->
    <header class="fixed top-0 z-50 w-full bg-white/95 backdrop-blur-sm">
      <div class="container-default flex h-20 items-center justify-between">
        <a href="/" class="text-xl font-bold text-gray-900">
          AI Resume Advisor
        </a>
        <nav class="hidden items-center gap-8 md:flex">
          <a href="#features" class="text-gray-600 hover:text-gray-900">About</a>
          <a href="#how-it-works" class="text-gray-600 hover:text-gray-900">How it works</a>
          <a href="#pricing" class="text-gray-600 hover:text-gray-900">Pricing</a>
        </nav>
        <div class="flex items-center gap-4">
          <a href="https://app.airesumeadvisor.com/login" class="hidden text-gray-600 hover:text-gray-900 sm:block">
            Log In
          </a>
          <a href="https://app.airesumeadvisor.com/signup" class="btn-primary">
            Sign Up Free
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </a>
        </div>
      </div>
    </header>

    <!-- Hero Section (Placeholder) -->
    <section class="section-padding mt-20 bg-gray-50">
      <div class="container-default">
        <div class="grid items-center gap-12 lg:grid-cols-2">
          <div>
            <h1 class="mb-6 text-gray-900">
              Land Your Dream Job with AI-Powered Resumes
            </h1>
            <p class="mb-8 text-lg text-gray-600">
              Get a resume tailored to each job posting, using the right keywords to stand out.
              Our AI Resume Builder analyzes job descriptions and your LinkedIn profile to create
              a personalized, optimized resume that gives you the competitive edge.
            </p>
            <a href="https://app.airesumeadvisor.com/signup" class="btn-primary">
              Sign Up Free
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </a>
          </div>
          <div class="relative">
            <!-- Hero image placeholder -->
            <div class="aspect-[4/3] rounded-2xl bg-gray-200 shadow-2xl">
              <div class="flex h-full items-center justify-center text-gray-400">
                [Hero Mockup Image]
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- More sections will be added -->
    <section id="features" class="section-padding">
      <div class="container-default text-center">
        <h2 class="mb-4">Unlock Dream Career with AI Hub</h2>
        <p class="text-gray-600">[Feature Tabs Component - Coming Soon]</p>
      </div>
    </section>

    <section id="how-it-works" class="section-padding bg-gray-50">
      <div class="container-default text-center">
        <h2 class="mb-4">How it Works</h2>
        <p class="text-gray-600">[How It Works Component - Coming Soon]</p>
      </div>
    </section>

    <section id="pricing" class="section-padding">
      <div class="container-default text-center">
        <h2 class="mb-4">Pricing</h2>
        <p class="text-gray-600">[Pricing Component - Coming Soon]</p>
      </div>
    </section>

    <!-- Footer -->
    <footer class="border-t border-gray-200 py-8">
      <div class="container-default flex flex-col items-center justify-between gap-4 sm:flex-row">
        <p class="text-sm text-gray-500">
          AI Resume Advisor &copy; 2024. All rights reserved.
        </p>
        <div class="flex gap-6">
          <a href="/terms" class="text-sm text-gray-500 hover:text-gray-700">Terms</a>
          <a href="/privacy" class="text-sm text-gray-500 hover:text-gray-700">Privacy</a>
        </div>
      </div>
    </footer>
  </main>
</Layout>
