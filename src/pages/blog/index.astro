---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BlogCard from '../../components/blog/BlogCard.astro';

// Get all posts, grouped by language
const allPosts = await getCollection('blog');
const englishPosts = allPosts
  .filter((post) => (post.data.lang || 'en') === 'en')
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const chinesePosts = allPosts
  .filter((post) => post.data.lang === 'zh-TW')
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout
  title="Blog | AI Resume Advisor"
  description="Expert tips, guides, and insights on resume writing, job searching, and career development. Learn how to stand out in the job market with AI-powered resume optimization."
>
  <Header />
  <main class="min-h-screen bg-gray-50">
    <!-- Hero Section -->
    <section class="bg-white py-16 md:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center">
          <h1 class="font-display text-4xl font-bold text-gray-900 sm:text-5xl">
            AI Resume Advisor Blog
          </h1>
          <p class="mx-auto mt-4 max-w-2xl text-lg text-gray-600">
            Expert tips and guides on resume writing, job searching, and career development.
          </p>

          <!-- Language Tabs -->
          <div class="mt-8 flex justify-center gap-2">
            <button
              id="tab-en"
              data-lang="en"
              class="lang-tab inline-flex items-center gap-2 rounded-full px-5 py-2 text-sm font-medium transition-all bg-primary text-white shadow-md"
            >
              <span>🇺🇸</span> English
            </button>
            <button
              id="tab-zh"
              data-lang="zh-TW"
              class="lang-tab inline-flex items-center gap-2 rounded-full px-5 py-2 text-sm font-medium transition-all bg-gray-100 text-gray-600 hover:bg-gray-200"
            >
              <span>🇹🇼</span> 繁體中文
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- Blog Posts Grid -->
    <section class="py-12 md:py-16">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <!-- English Posts -->
        <div id="posts-en" class="posts-container">
          {
            englishPosts.length > 0 ? (
              <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
                {englishPosts.map((post) => (
                  <BlogCard
                    title={post.data.title}
                    description={post.data.description}
                    pubDate={post.data.pubDate}
                    slug={post.slug}
                    image={post.data.image}
                    lang={post.data.lang}
                  />
                ))}
              </div>
            ) : (
              <div class="py-16 text-center">
                <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-gray-100">
                  <svg class="h-8 w-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                  </svg>
                </div>
                <h3 class="text-lg font-medium text-gray-900">No posts yet</h3>
                <p class="mt-1 text-gray-500">Check back soon for new content!</p>
              </div>
            )
          }
        </div>

        <!-- Chinese Posts (hidden by default) -->
        <div id="posts-zh" class="posts-container hidden">
          {
            chinesePosts.length > 0 ? (
              <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
                {chinesePosts.map((post) => (
                  <BlogCard
                    title={post.data.title}
                    description={post.data.description}
                    pubDate={post.data.pubDate}
                    slug={post.slug}
                    image={post.data.image}
                    lang={post.data.lang}
                  />
                ))}
              </div>
            ) : (
              <div class="py-16 text-center">
                <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-gray-100">
                  <svg class="h-8 w-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                  </svg>
                </div>
                <h3 class="text-lg font-medium text-gray-900">目前沒有文章</h3>
                <p class="mt-1 text-gray-500">請稍後再來查看！</p>
              </div>
            )
          }
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  const tabEn = document.getElementById('tab-en');
  const tabZh = document.getElementById('tab-zh');
  const postsEn = document.getElementById('posts-en');
  const postsZh = document.getElementById('posts-zh');

  const activeClass = 'bg-primary text-white shadow-md';
  const inactiveClass = 'bg-gray-100 text-gray-600 hover:bg-gray-200';

  function setActiveTab(lang: string) {
    if (lang === 'en') {
      tabEn?.classList.remove(...inactiveClass.split(' '));
      tabEn?.classList.add(...activeClass.split(' '));
      tabZh?.classList.remove(...activeClass.split(' '));
      tabZh?.classList.add(...inactiveClass.split(' '));
      postsEn?.classList.remove('hidden');
      postsZh?.classList.add('hidden');
    } else {
      tabZh?.classList.remove(...inactiveClass.split(' '));
      tabZh?.classList.add(...activeClass.split(' '));
      tabEn?.classList.remove(...activeClass.split(' '));
      tabEn?.classList.add(...inactiveClass.split(' '));
      postsZh?.classList.remove('hidden');
      postsEn?.classList.add('hidden');
    }
    // Update URL without reload
    const url = new URL(window.location.href);
    if (lang === 'en') {
      url.searchParams.delete('lang');
    } else {
      url.searchParams.set('lang', lang);
    }
    window.history.replaceState({}, '', url.toString());
  }

  // Check URL on load
  const urlParams = new URLSearchParams(window.location.search);
  const langParam = urlParams.get('lang');
  if (langParam === 'zh-TW') {
    setActiveTab('zh-TW');
  }

  // Tab click handlers
  tabEn?.addEventListener('click', () => setActiveTab('en'));
  tabZh?.addEventListener('click', () => setActiveTab('zh-TW'));
</script>
