---
import Layout from '@layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Privacy Policy - AI Resume Advisor">
  <Header />

  <main class="bg-gradient-to-b from-white to-gray-50 py-16 md:py-24">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <!-- Page Header -->
      <div class="mb-16 text-center">
        <h1 class="font-display text-4xl font-bold tracking-tight text-text-primary md:text-5xl">
          Privacy Policy
        </h1>
        <p class="mt-4 text-lg text-text-caption">Last Updated: November 28, 2025</p>
      </div>

      <!-- Content -->
      <div class="space-y-12">
        <!-- Section 1 -->
        <section class="rounded-2xl bg-white p-8 shadow-sm">
          <h2
            class="flex items-center gap-3 font-display text-xl font-bold text-text-primary md:text-2xl"
          >
            <span
              class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary text-sm font-bold text-white"
              >1</span
            >
            Introduction
          </h2>
          <div class="mt-6 space-y-4 text-text-body">
            <p>
              AI Resume Advisor LLC ("we," "our," or "company") respects and protects your privacy.
              This Privacy Policy explains how we collect, use, share, and protect your personal
              information. By using our services, you agree to the practices described in this
              policy.
            </p>
            <p>
              Our principal office address is: <strong
                >30 N Gould St Ste N Sheridan, WY 82801</strong
              >.
            </p>
          </div>
        </section>

        <!-- Section 2 -->
        <section class="rounded-2xl bg-white p-8 shadow-sm">
          <h2
            class="flex items-center gap-3 font-display text-xl font-bold text-text-primary md:text-2xl"
          >
            <span
              class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary text-sm font-bold text-white"
              >2</span
            >
            Information We Collect
          </h2>
          <div class="mt-6 space-y-4 text-text-body">
            <p>We may collect the following types of information:</p>
            <div class="mt-4 grid gap-4 md:grid-cols-2">
              <div class="rounded-xl border border-gray-100 bg-gray-50 p-4">
                <h3 class="font-semibold text-text-primary">Account Information</h3>
                <p class="mt-2 text-sm">
                  Name, email address, and password provided when creating an account.
                </p>
              </div>
              <div class="rounded-xl border border-gray-100 bg-gray-50 p-4">
                <h3 class="font-semibold text-text-primary">Resume Content</h3>
                <p class="mt-2 text-sm">
                  Resume text, job descriptions, LinkedIn data, alignment scores, and simulator
                  selections.
                </p>
              </div>
              <div class="rounded-xl border border-gray-100 bg-gray-50 p-4">
                <h3 class="font-semibold text-text-primary">Career Information</h3>
                <p class="mt-2 text-sm">Job preferences, target positions, expected salary, etc.</p>
              </div>
              <div class="rounded-xl border border-gray-100 bg-gray-50 p-4">
                <h3 class="font-semibold text-text-primary">Usage Information</h3>
                <p class="mt-2 text-sm">Pages visited, features used, documents created, etc.</p>
              </div>
              <div class="rounded-xl border border-gray-100 bg-gray-50 p-4">
                <h3 class="font-semibold text-text-primary">Device Information</h3>
                <p class="mt-2 text-sm">
                  Device type, OS, browser, IP address, language preferences.
                </p>
              </div>
              <div class="rounded-xl border border-gray-100 bg-gray-50 p-4">
                <h3 class="font-semibold text-text-primary">Payment Information</h3>
                <p class="mt-2 text-sm">
                  Processed securely by third-party payment processors (Stripe).
                </p>
              </div>
            </div>
            <p class="mt-4 text-sm text-text-caption">
              We only collect information necessary to provide our services and are committed to
              protecting your privacy.
            </p>
          </div>
        </section>

        <!-- Section 3 -->
        <section class="rounded-2xl bg-white p-8 shadow-sm">
          <h2
            class="flex items-center gap-3 font-display text-xl font-bold text-text-primary md:text-2xl"
          >
            <span
              class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary text-sm font-bold text-white"
              >3</span
            >
            How We Use Your Information
          </h2>
          <div class="mt-6 text-text-body">
            <p class="mb-4">We use the collected information to:</p>
            <ul class="space-y-3">
              <li class="flex items-start gap-3">
                <svg
                  class="mt-1 h-5 w-5 flex-shrink-0 text-success"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span>Provide and improve our services</span>
              </li>
              <li class="flex items-start gap-3">
                <svg
                  class="mt-1 h-5 w-5 flex-shrink-0 text-success"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span>Personalize your experience</span>
              </li>
              <li class="flex items-start gap-3">
                <svg
                  class="mt-1 h-5 w-5 flex-shrink-0 text-success"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span>Conduct analysis and research</span>
              </li>
              <li class="flex items-start gap-3">
                <svg
                  class="mt-1 h-5 w-5 flex-shrink-0 text-success"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span>Communicate with you</span>
              </li>
              <li class="flex items-start gap-3">
                <svg
                  class="mt-1 h-5 w-5 flex-shrink-0 text-success"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span>Protect our legitimate interests</span>
              </li>
            </ul>
          </div>
        </section>

        <!-- Section 4 -->
        <section class="rounded-2xl bg-white p-8 shadow-sm">
          <h2
            class="flex items-center gap-3 font-display text-xl font-bold text-text-primary md:text-2xl"
          >
            <span
              class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary text-sm font-bold text-white"
              >4</span
            >
            Information Sharing and Disclosure
          </h2>
          <div class="mt-6 space-y-4 text-text-body">
            <p>
              We value your privacy and strictly limit the sharing of your information. We may share
              your information in the following circumstances:
            </p>
            <ul class="space-y-3">
              <li class="flex items-start gap-3">
                <span
                  class="mt-1 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-primary-light text-xs font-medium text-primary"
                  >a</span
                >
                <span
                  ><strong>With your explicit consent:</strong> We will only share your data with third
                  parties when you explicitly agree.</span
                >
              </li>
              <li class="flex items-start gap-3">
                <span
                  class="mt-1 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-primary-light text-xs font-medium text-primary"
                  >b</span
                >
                <span
                  ><strong>Service providers:</strong> Third-party providers who help deliver our services
                  (e.g., cloud storage, payment processors).</span
                >
              </li>
              <li class="flex items-start gap-3">
                <span
                  class="mt-1 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-primary-light text-xs font-medium text-primary"
                  >c</span
                >
                <span
                  ><strong>Legal requirements:</strong> When required by law or to protect our legitimate
                  interests.</span
                >
              </li>
              <li class="flex items-start gap-3">
                <span
                  class="mt-1 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-primary-light text-xs font-medium text-primary"
                  >d</span
                >
                <span
                  ><strong>Business transfers:</strong> In the event of a merger, acquisition, or asset
                  sale.</span
                >
              </li>
            </ul>
            <div class="mt-6 rounded-xl border-2 border-primary-light bg-primary-light/50 p-4">
              <p class="text-sm font-medium text-primary">
                We will never sell, rent, or share your personal information or resume data with any
                third party for marketing purposes without your explicit permission.
              </p>
            </div>
          </div>
        </section>

        <!-- Section 5 -->
        <section class="rounded-2xl bg-white p-8 shadow-sm">
          <h2
            class="flex items-center gap-3 font-display text-xl font-bold text-text-primary md:text-2xl"
          >
            <span
              class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary text-sm font-bold text-white"
              >5</span
            >
            Cookies and Tracking Technologies
          </h2>
          <div class="mt-6 space-y-4 text-text-body">
            <p>
              We use cookies and similar tracking technologies to improve your experience. Types of
              cookies we use:
            </p>
            <div class="mt-4 grid gap-4 md:grid-cols-2">
              <div class="rounded-xl border border-gray-100 bg-gray-50 p-4">
                <h3 class="font-semibold text-text-primary">Essential Cookies</h3>
                <p class="mt-2 text-sm">
                  Necessary for basic website functionality, such as keeping you logged in.
                </p>
              </div>
              <div class="rounded-xl border border-gray-100 bg-gray-50 p-4">
                <h3 class="font-semibold text-text-primary">Analytics Cookies</h3>
                <p class="mt-2 text-sm">
                  Help us understand how our website is used to improve user experience.
                </p>
              </div>
              <div class="rounded-xl border border-gray-100 bg-gray-50 p-4">
                <h3 class="font-semibold text-text-primary">Functional Cookies</h3>
                <p class="mt-2 text-sm">
                  Remember your choices (language, preferences) for a personalized experience.
                </p>
              </div>
              <div class="rounded-xl border border-gray-100 bg-gray-50 p-4">
                <h3 class="font-semibold text-text-primary">Advertising Cookies</h3>
                <p class="mt-2 text-sm">May be used to provide ads relevant to your interests.</p>
              </div>
            </div>
            <p class="mt-4 text-sm">
              You can control cookies through your browser settings. Our website also responds to
              "Do Not Track" signals.
            </p>
          </div>
        </section>

        <!-- Section 6 -->
        <section class="rounded-2xl bg-white p-8 shadow-sm">
          <h2
            class="flex items-center gap-3 font-display text-xl font-bold text-text-primary md:text-2xl"
          >
            <span
              class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary text-sm font-bold text-white"
              >6</span
            >
            Your Rights
          </h2>
          <div class="mt-6 text-text-body">
            <p class="mb-4">
              According to applicable data protection laws, you may have the following rights:
            </p>
            <div class="grid gap-3 md:grid-cols-2 lg:grid-cols-3">
              <div
                class="flex items-center gap-2 rounded-lg border border-gray-200 bg-gray-50 px-4 py-3"
              >
                <svg
                  class="h-5 w-5 text-primary"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
                  ></path>
                </svg>
                <span class="text-sm font-medium">Access your data</span>
              </div>
              <div
                class="flex items-center gap-2 rounded-lg border border-gray-200 bg-gray-50 px-4 py-3"
              >
                <svg
                  class="h-5 w-5 text-primary"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"
                  ></path>
                </svg>
                <span class="text-sm font-medium">Correct inaccuracies</span>
              </div>
              <div
                class="flex items-center gap-2 rounded-lg border border-gray-200 bg-gray-50 px-4 py-3"
              >
                <svg
                  class="h-5 w-5 text-primary"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
                  ></path>
                </svg>
                <span class="text-sm font-medium">Delete your data</span>
              </div>
              <div
                class="flex items-center gap-2 rounded-lg border border-gray-200 bg-gray-50 px-4 py-3"
              >
                <svg
                  class="h-5 w-5 text-primary"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"
                  ></path>
                </svg>
                <span class="text-sm font-medium">Restrict processing</span>
              </div>
              <div
                class="flex items-center gap-2 rounded-lg border border-gray-200 bg-gray-50 px-4 py-3"
              >
                <svg
                  class="h-5 w-5 text-primary"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                </svg>
                <span class="text-sm font-medium">Data portability</span>
              </div>
            </div>
            <p class="mt-6 text-sm">
              To exercise these rights, please email <a
                href="mailto:wenhao@airesumeadvisor.com"
                class="font-medium text-primary hover:text-primary-hover"
                >wenhao@airesumeadvisor.com</a
              >. We will respond within 30 days.
            </p>
          </div>
        </section>

        <!-- Section 7 -->
        <section class="rounded-2xl bg-white p-8 shadow-sm">
          <h2
            class="flex items-center gap-3 font-display text-xl font-bold text-text-primary md:text-2xl"
          >
            <span
              class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary text-sm font-bold text-white"
              >7</span
            >
            Data Retention
          </h2>
          <div class="mt-6 space-y-4 text-text-body">
            <p>
              We retain your personal information for as long as necessary to fulfill the purposes
              described in this Privacy Policy:
            </p>
            <ul class="space-y-3">
              <li class="flex items-start gap-3">
                <span
                  class="mt-1 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-primary-light text-xs font-medium text-primary"
                  >1</span
                >
                <span
                  ><strong>Account data:</strong> Retained while your account is active. You can request
                  deletion at any time.</span
                >
              </li>
              <li class="flex items-start gap-3">
                <span
                  class="mt-1 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-primary-light text-xs font-medium text-primary"
                  >2</span
                >
                <span
                  ><strong>Usage data:</strong> Retained in aggregate or anonymized form for analytics.</span
                >
              </li>
              <li class="flex items-start gap-3">
                <span
                  class="mt-1 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-primary-light text-xs font-medium text-primary"
                  >3</span
                >
                <span
                  ><strong>Communication records:</strong> Retained for customer support purposes.</span
                >
              </li>
            </ul>
          </div>
        </section>

        <!-- Section 8 -->
        <section class="rounded-2xl bg-white p-8 shadow-sm">
          <h2
            class="flex items-center gap-3 font-display text-xl font-bold text-text-primary md:text-2xl"
          >
            <span
              class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary text-sm font-bold text-white"
              >8</span
            >
            Security Measures
          </h2>
          <div class="mt-6 text-text-body">
            <p class="mb-4">
              We employ multi-layered security measures to protect your personal information:
            </p>
            <div class="grid gap-3 md:grid-cols-2 lg:grid-cols-3">
              <div
                class="flex items-center gap-2 rounded-lg border border-gray-200 bg-gray-50 px-4 py-3"
              >
                <svg
                  class="h-5 w-5 text-success"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
                  ></path>
                </svg>
                <span class="text-sm">SSL/TLS Encryption</span>
              </div>
              <div
                class="flex items-center gap-2 rounded-lg border border-gray-200 bg-gray-50 px-4 py-3"
              >
                <svg
                  class="h-5 w-5 text-success"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                  ></path>
                </svg>
                <span class="text-sm">Access Control</span>
              </div>
              <div
                class="flex items-center gap-2 rounded-lg border border-gray-200 bg-gray-50 px-4 py-3"
              >
                <svg
                  class="h-5 w-5 text-success"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4"
                  ></path>
                </svg>
                <span class="text-sm">Regular Backups</span>
              </div>
              <div
                class="flex items-center gap-2 rounded-lg border border-gray-200 bg-gray-50 px-4 py-3"
              >
                <svg
                  class="h-5 w-5 text-success"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"
                  ></path>
                </svg>
                <span class="text-sm">Security Audits</span>
              </div>
              <div
                class="flex items-center gap-2 rounded-lg border border-gray-200 bg-gray-50 px-4 py-3"
              >
                <svg
                  class="h-5 w-5 text-success"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"
                  ></path>
                </svg>
                <span class="text-sm">Employee Training</span>
              </div>
              <div
                class="flex items-center gap-2 rounded-lg border border-gray-200 bg-gray-50 px-4 py-3"
              >
                <svg
                  class="h-5 w-5 text-success"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
                  ></path>
                </svg>
                <span class="text-sm">Physical Security</span>
              </div>
            </div>
          </div>
        </section>

        <!-- Section 9-11 -->
        <section class="rounded-2xl bg-white p-8 shadow-sm">
          <h2
            class="flex items-center gap-3 font-display text-xl font-bold text-text-primary md:text-2xl"
          >
            <span
              class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary text-sm font-bold text-white"
              >9</span
            >
            Age Restriction
          </h2>
          <div class="mt-6 text-text-body">
            <p>
              Our services are intended for users 18 years of age and older. If we become aware that
              we have collected personal information from users under 18, we will take steps to
              promptly delete that information.
            </p>
          </div>
        </section>

        <section class="rounded-2xl bg-white p-8 shadow-sm">
          <h2
            class="flex items-center gap-3 font-display text-xl font-bold text-text-primary md:text-2xl"
          >
            <span
              class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary text-sm font-bold text-white"
              >10</span
            >
            Policy Updates
          </h2>
          <div class="mt-6 text-text-body">
            <p>
              We may update this Privacy Policy from time to time. We will post the updated version
              on our website and notify you of any significant changes.
            </p>
          </div>
        </section>

        <section class="rounded-2xl bg-white p-8 shadow-sm">
          <h2
            class="flex items-center gap-3 font-display text-xl font-bold text-text-primary md:text-2xl"
          >
            <span
              class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary text-sm font-bold text-white"
