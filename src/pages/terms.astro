---
import Layout from '@layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Terms of Service - AI Resume Advisor">
  <Header />

  <main class="bg-gradient-to-b from-white to-gray-50 py-16 md:py-24">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <!-- Page Header -->
      <div class="mb-16 text-center">
        <h1 class="font-display text-4xl font-bold tracking-tight text-text-primary md:text-5xl">
          Terms of Service
        </h1>
        <p class="mt-4 text-lg text-text-caption">Last Updated: December 10, 2025</p>
      </div>

      <!-- Content -->
      <div class="space-y-12">
        <!-- Section 1 -->
        <section class="rounded-2xl bg-white p-8 shadow-sm">
          <h2
            class="flex items-center gap-3 font-display text-xl font-bold text-text-primary md:text-2xl"
          >
            <span
              class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary text-sm font-bold text-white"
              >1</span
            >
            Welcome to AI Resume Advisor LLC
          </h2>
          <div class="mt-6 space-y-4 text-text-body">
            <p>
              Welcome to the services provided by AI Resume Advisor LLC ("we," "our," or "Company"),
              registered at 30 N Gould St Ste N Sheridan, WY 82801. These Terms of Service ("Terms")
              establish the conditions that apply to you when you use our website, web application,
              browser extension, and related services (collectively, the "Service").
            </p>
            <p>
              By accessing or using our Service, you agree to be bound by these Terms. If you do not
              agree to these Terms, please do not use our Service.
            </p>
          </div>
        </section>

        <!-- Section 2 -->
        <section class="rounded-2xl bg-white p-8 shadow-sm">
          <h2
            class="flex items-center gap-3 font-display text-xl font-bold text-text-primary md:text-2xl"
          >
            <span
              class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary text-sm font-bold text-white"
              >2</span
            >
            Description of Service
          </h2>
          <div class="mt-6 space-y-4 text-text-body">
            <p>AI Resume Advisor LLC provides the following services:</p>
            <div class="mt-4 grid gap-4 md:grid-cols-2">
              <div class="rounded-xl border border-gray-100 bg-gray-50 p-4">
                <h3 class="font-semibold text-text-primary">Job-Resume Alignment Analysis</h3>
                <p class="mt-2 text-sm">
                  Our AI analyzes job descriptions and your resume to calculate an Alignment Score
                  and Keyword Coverage Rate.
                </p>
              </div>
              <div class="rounded-xl border border-gray-100 bg-gray-50 p-4">
                <h3 class="font-semibold text-text-primary">Gap Identification</h3>
                <p class="mt-2 text-sm">
                  We identify Presentation Gaps (skills not effectively communicated) and Skill Gaps
                  (skills to develop).
                </p>
              </div>
              <div class="rounded-xl border border-gray-100 bg-gray-50 p-4">
                <h3 class="font-semibold text-text-primary">AI-Powered Optimization</h3>
                <p class="mt-2 text-sm">
                  Our AI rewrites your resume to better showcase your experience in the language
                  employers want.
                </p>
              </div>
              <div class="rounded-xl border border-gray-100 bg-gray-50 p-4">
                <h3 class="font-semibold text-text-primary">Skill Development</h3>
                <p class="mt-2 text-sm">
                  We recommend courses and certifications with guidance on what to learn and how
                  much it matters.
                </p>
              </div>
              <div class="rounded-xl border border-gray-100 bg-gray-50 p-4">
                <h3 class="font-semibold text-text-primary">Job Alignment Simulator</h3>
                <p class="mt-2 text-sm">
                  Add skills to your resume and see your alignment score change in real time.
                </p>
              </div>
              <div class="rounded-xl border border-gray-100 bg-gray-50 p-4">
                <h3 class="font-semibold text-text-primary">Career Assessment Reports</h3>
                <p class="mt-2 text-sm">
                  Detailed reports including strengths, weaknesses, quick wins, and personalized
                  suggestions.
                </p>
              </div>
              <div class="rounded-xl border border-gray-100 bg-gray-50 p-4">
                <h3 class="font-semibold text-text-primary">Browser Extension</h3>
                <p class="mt-2 text-sm">
                  Analyze LinkedIn job postings directly from the LinkedIn website with instant
                  alignment scores and keyword coverage.
                </p>
              </div>
            </div>
          </div>
        </section>

        <!-- Section 3 -->
        <section class="rounded-2xl bg-white p-8 shadow-sm">
          <h2
            class="flex items-center gap-3 font-display text-xl font-bold text-text-primary md:text-2xl"
          >
            <span
              class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary text-sm font-bold text-white"
              >3</span
            >
            User Registration and Account
          </h2>
          <div class="mt-6 text-text-body">
            <ul class="space-y-3">
              <li class="flex items-start gap-3">
                <span
                  class="mt-1 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-primary-light text-xs font-medium text-primary"
                  >a</span
                >
                <span>You must be at least 18 years old to use our Service.</span>
              </li>
              <li class="flex items-start gap-3">
                <span
                  class="mt-1 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-primary-light text-xs font-medium text-primary"
                  >b</span
                >
                <span>You need to register an account to use certain features of our Service.</span>
              </li>
              <li class="flex items-start gap-3">
                <span
                  class="mt-1 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-primary-light text-xs font-medium text-primary"
                  >c</span
                >
                <span
                  >You are responsible for maintaining the security of your account, including
                  protecting your password.</span
                >
              </li>
              <li class="flex items-start gap-3">
                <span
                  class="mt-1 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-primary-light text-xs font-medium text-primary"
                  >d</span
                >
                <span
                  >You agree to provide accurate, complete, and up-to-date registration information.</span
                >
              </li>
            </ul>
          </div>
        </section>

        <!-- Section 4 -->
        <section class="rounded-2xl bg-white p-8 shadow-sm">
          <h2
            class="flex items-center gap-3 font-display text-xl font-bold text-text-primary md:text-2xl"
          >
            <span
              class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary text-sm font-bold text-white"
              >4</span
            >
            User Responsibilities and Code of Conduct
          </h2>
          <div class="mt-6 text-text-body">
            <p class="mb-4">When using our Service, you agree to:</p>
            <ul class="space-y-3">
              <li class="flex items-start gap-3">
                <span
                  class="mt-1 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-primary-light text-xs font-medium text-primary"
                  >a</span
                >
                <span>Not violate any applicable laws or regulations.</span>
              </li>
              <li class="flex items-start gap-3">
                <span
                  class="mt-1 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-primary-light text-xs font-medium text-primary"
                  >b</span
                >
                <span>Not infringe on the intellectual property or other rights of others.</span>
              </li>
              <li class="flex items-start gap-3">
                <span
                  class="mt-1 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-primary-light text-xs font-medium text-primary"
                  >c</span
                >
                <span
                  >Not upload materials containing viruses, malicious code, or other harmful
                  content.</span
                >
              </li>
              <li class="flex items-start gap-3">
                <span
                  class="mt-1 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-primary-light text-xs font-medium text-primary"
                  >d</span
                >
                <span
                  >Not engage in behavior that may damage the Service or affect other users'
                  experience.</span
                >
              </li>
            </ul>
          </div>
        </section>

        <!-- Section 5 - Browser Extension Usage -->
        <section class="rounded-2xl bg-white p-8 shadow-sm">
          <h2
            class="flex items-center gap-3 font-display text-xl font-bold text-text-primary md:text-2xl"
          >
            <span
              class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary text-sm font-bold text-white"
              >5</span
            >
            Browser Extension Usage
          </h2>
          <div class="mt-6 text-text-body">
            <p class="mb-4">When using our Chrome Extension, you additionally agree to:</p>
            <ul class="space-y-3">
              <li class="flex items-start gap-3">
                <span
                  class="mt-1 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-primary-light text-xs font-medium text-primary"
                  >a</span
                >
                <span>Use the extension only for personal job search purposes.</span>
              </li>
              <li class="flex items-start gap-3">
                <span
                  class="mt-1 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-primary-light text-xs font-medium text-primary"
                  >b</span
                >
                <span>Not use automated tools or scripts to mass-analyze job postings.</span>
              </li>
              <li class="flex items-start gap-3">
                <span
                  class="mt-1 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-primary-light text-xs font-medium text-primary"
                  >c</span
                >
                <span>Comply with LinkedIn's Terms of Service while using the extension.</span>
              </li>
              <li class="flex items-start gap-3">
                <span
                  class="mt-1 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-primary-light text-xs font-medium text-primary"
                  >d</span
                >
                <span
                  >Grant the extension necessary permissions (storage, activeTab, scripting,
                  identity) for proper functionality.</span
                >
              </li>
            </ul>
            <div class="mt-6 rounded-xl border border-gray-200 bg-gray-50 p-4">
              <h3 class="font-semibold text-text-primary">Usage Limits</h3>
              <p class="mt-2 text-sm text-text-body">
                The extension has fair usage limits that vary by account type. Current limits are
                displayed within the extension and may be adjusted to maintain service quality for
                all users.
              </p>
            </div>
            <p class="mt-4 text-sm text-text-caption">
              We reserve the right to limit or suspend extension access for users who violate these
              terms or abuse the service.
            </p>
          </div>
        </section>

        <!-- Section 6 -->
        <section class="rounded-2xl bg-white p-8 shadow-sm">
          <h2
            class="flex items-center gap-3 font-display text-xl font-bold text-text-primary md:text-2xl"
          >
            <span
              class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary text-sm font-bold text-white"
              >6</span
            >
            Intellectual Property and User Content
          </h2>
          <div class="mt-6 space-y-4 text-text-body">
            <p>
              <strong>Our Property:</strong> Our Service, including all related intellectual property
              rights, is owned by AI Resume Advisor LLC.
            </p>
            <p>
              <strong>Your Content:</strong> You retain full ownership and control over the content you
              upload to our Service, including your resume and personal information. By using our Service,
              you grant us a limited license to store, process, and analyze your content solely for the
              purpose of providing and improving our Service to you.
            </p>
            <p>
              We will not use your personal information or resume content for any other purpose
              without your explicit consent. You can delete your content from our Service at any
              time.
            </p>
          </div>
        </section>

        <!-- Section 7 -->
        <section class="rounded-2xl bg-white p-8 shadow-sm">
          <h2
            class="flex items-center gap-3 font-display text-xl font-bold text-text-primary md:text-2xl"
          >
            <span
              class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary text-sm font-bold text-white"
              >7</span
            >
            Privacy and Data Processing
          </h2>
          <div class="mt-6 text-text-body">
            <p>
              We value your privacy. Please refer to our <a
                href="/privacy"
                class="font-medium text-primary hover:text-primary-hover">Privacy Policy</a
              > for information on how we collect, use, and protect your personal information.
            </p>
          </div>
        </section>

        <!-- Section 8 - Pricing -->
        <section class="rounded-2xl bg-white p-8 shadow-sm">
          <h2
            class="flex items-center gap-3 font-display text-xl font-bold text-text-primary md:text-2xl"
          >
            <span
              class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary text-sm font-bold text-white"
              >8</span
            >
            Payment and Subscriptions
          </h2>
          <div class="mt-6 space-y-6 text-text-body">
            <p>We offer both free and paid services:</p>
            <div class="grid gap-4 md:grid-cols-3">
              <div class="rounded-xl border-2 border-gray-200 p-4 text-center">
                <p class="text-2xl font-bold text-text-primary">Free</p>
                <p class="text-sm text-text-caption">10 credits/day</p>
                <p class="mt-2 text-xs text-text-body">~5 complete job assessments</p>
              </div>
              <div class="rounded-xl border-2 border-gray-200 p-4 text-center">
                <p class="text-2xl font-bold text-text-primary">$6</p>
                <p class="text-sm text-text-caption">Daily Pass (24 hours)</p>
                <p class="mt-2 text-xs text-text-body">Unlimited access</p>
              </div>
              <div class="rounded-xl border-2 border-primary bg-primary-light p-4 text-center">
                <p class="text-2xl font-bold text-primary">$20</p>
                <p class="text-sm text-text-caption">Weekly Pass (7 days)</p>
                <p class="mt-2 text-xs font-medium text-primary">Best Value - Save 50%+</p>
              </div>
            </div>
            <ul class="mt-4 space-y-2 text-sm">
              <li>
                Payments are processed through Stripe. By using our paid services, you agree to
                Stripe's terms of service.
              </li>
              <li>
                Subscriptions do not automatically renew. Each pass expires after its designated
                period.
              </li>
              <li>
                Refund Policy: Refunds are available within 24 hours of purchase if the service
                has not been used. A non-refundable processing fee applies: $0.50 for Daily Pass,
                $1.00 for Weekly Pass. Once any analysis or report has been generated, purchases
                are final. To request a refund, contact wenhao@airesumeadvisor.com.
              </li>
            </ul>
          </div>
        </section>

        <!-- Section 9-13 -->
        <section class="rounded-2xl bg-white p-8 shadow-sm">
          <h2
            class="flex items-center gap-3 font-display text-xl font-bold text-text-primary md:text-2xl"
          >
            <span
              class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary text-sm font-bold text-white"
              >9</span
            >
            Termination
          </h2>
          <div class="mt-6 text-text-body">
            <p>
              We reserve the right to terminate or suspend your use of the Service at any time for
              any reason, including breach of these Terms.
            </p>
          </div>
        </section>

        <section class="rounded-2xl bg-white p-8 shadow-sm">
          <h2
            class="flex items-center gap-3 font-display text-xl font-bold text-text-primary md:text-2xl"
          >
            <span
              class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary text-sm font-bold text-white"
              >10</span
            >
            Disclaimer and Limitation of Liability
          </h2>
          <div class="mt-6 space-y-4 text-text-body">
            <p>Our Service is provided "as is" without any express or implied warranties.</p>
            <p>
              To the maximum extent permitted by law, AI Resume Advisor LLC shall not be liable for
              any direct, indirect, incidental, special, or consequential damages.
            </p>
          </div>
        </section>

        <section class="rounded-2xl bg-white p-8 shadow-sm">
          <h2
            class="flex items-center gap-3 font-display text-xl font-bold text-text-primary md:text-2xl"
          >
            <span
              class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary text-sm font-bold text-white"
              >11</span
            >
            Dispute Resolution and Governing Law
          </h2>
          <div class="mt-6 text-text-body">
            <ul class="space-y-3">
              <li class="flex items-start gap-3">
                <span
                  class="mt-1 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-primary-light text-xs font-medium text-primary"
                  >a</span
                >
                <span>These Terms are governed by the laws of the State of Wyoming.</span>
              </li>
              <li class="flex items-start gap-3">
                <span
                  class="mt-1 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-primary-light text-xs font-medium text-primary"
                  >b</span
                >
                <span>Any disputes should first be resolved through friendly negotiation.</span>
              </li>
              <li class="flex items-start gap-3">
                <span
                  class="mt-1 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-primary-light text-xs font-medium text-primary"
                  >c</span
                >
                <span
                  >If resolution cannot be reached, disputes will be submitted to Wyoming courts.</span
                >
              </li>
            </ul>
          </div>
        </section>

        <section class="rounded-2xl bg-white p-8 shadow-sm">
          <h2
            class="flex items-center gap-3 font-display text-xl font-bold text-text-primary md:text-2xl"
          >
            <span
              class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary text-sm font-bold text-white"
              >12</span
            >
            Modifications to Terms
          </h2>
          <div class="mt-6 text-text-body">
            <p>
              We may modify these Terms from time to time. Modified terms will be posted on the
              website and will be effective immediately upon posting. Continued use of our Service
              after any such changes shall constitute your consent to such changes.
            </p>
          </div>
        </section>

        <section class="rounded-2xl bg-white p-8 shadow-sm">
          <h2
            class="flex items-center gap-3 font-display text-xl font-bold text-text-primary md:text-2xl"
          >
            <span
              class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary text-sm font-bold text-white"
              >13</span
            >
            Contact Us
          </h2>
          <div class="mt-6 text-text-body">
            <p>If you have any questions about these Terms, please contact us at:</p>
            <a
              href="mailto:wenhao@airesumeadvisor.com"
              class="mt-4 inline-flex items-center gap-2 font-medium text-primary hover:text-primary-hover"
            >
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                ></path>
              </svg>
              wenhao@airesumeadvisor.com
            </a>
          </div>
        </section>

        <!-- Footer Note -->
        <div class="rounded-2xl bg-primary-light p-6 text-center">
          <p class="text-sm text-primary">
            By using our Service, you acknowledge that you have read, understood, and agree to be
            bound by these Terms.
          </p>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
