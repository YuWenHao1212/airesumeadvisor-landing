---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import BlogCard from '../../../components/blog/BlogCard.astro';
import { useTranslations } from '../../../i18n/utils';

const lang = 'zh-TW' as const;
const t = useTranslations(lang);

const allPosts = await getCollection('blog');
const chinesePosts = allPosts
  .filter((post) => post.data.lang === 'zh-TW')
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout
  title={t('blog.meta.title')}
  description={t('blog.meta.description')}
  lang={lang}
>
  <Header lang={lang} />
  <main class="min-h-screen bg-gray-50">
    <!-- Hero Section -->
    <section class="bg-white py-16 md:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center">
          <h1 class="font-display text-4xl font-bold text-gray-900 sm:text-5xl">
            AI Resume Advisor 部落格
          </h1>
          <p class="mx-auto mt-4 max-w-2xl text-lg text-gray-600">
            履歷優化技巧與策略，幫助你獲得夢想工作。
          </p>

          <!-- Cross-link to EN blog -->
          <div class="mt-6">
            <a
              href="/blog/"
              class="inline-flex items-center gap-2 rounded-full border border-gray-300 px-5 py-2 text-sm font-medium text-gray-600 transition-all hover:border-primary hover:text-primary"
            >
              <span>🇺🇸</span> Read in English
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Blog Posts Grid -->
    <section class="py-12 md:py-16">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        {
          chinesePosts.length > 0 ? (
            <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
              {chinesePosts.map((post) => {
                const cleanSlug = post.slug.replace(/^zh\//, '');
                return (
                  <BlogCard
                    title={post.data.title}
                    description={post.data.description}
                    pubDate={post.data.pubDate}
                    slug={cleanSlug}
                    image={post.data.image}
                    locale="zh-TW"
                  />
                );
              })}
            </div>
          ) : (
            <div class="py-16 text-center">
              <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-gray-100">
                <svg class="h-8 w-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                </svg>
              </div>
              <h3 class="text-lg font-medium text-gray-900">目前沒有文章</h3>
              <p class="mt-1 text-gray-500">請稍後再來查看！</p>
            </div>
          )
        }
      </div>
    </section>
  </main>
  <Footer lang={lang} />
</Layout>
