---
import Layout from '@layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { useTranslations } from '../../i18n/utils';

const lang = 'zh-TW' as const;
const t = useTranslations(lang);
---

<Layout
  title="服務條款 - AI Resume Advisor"
  description="查看 AI Resume Advisor 的服務條款與使用規範。了解你在使用我們履歷優化服務時的權利與責任。"
  lang={lang}
>
  <Header lang={lang} />

  <main class="bg-gradient-to-b from-white to-gray-50 py-16 md:py-24">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <!-- Page Header -->
      <div class="mb-16 text-center">
        <h1 class="font-display text-4xl font-bold tracking-tight text-text-primary md:text-5xl">
          服務條款
        </h1>
        <p class="mt-4 text-lg text-text-caption">最後更新：2025 年 12 月 10 日</p>
      </div>

      <!-- Content -->
      <div class="space-y-12">
        <!-- Section 1 -->
        <section class="rounded-2xl bg-white p-8 shadow-sm">
          <h2
            class="flex items-center gap-3 font-display text-xl font-bold text-text-primary md:text-2xl"
          >
            <span
              class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary text-sm font-bold text-white"
              >1</span
            >
            歡迎使用 AI Resume Advisor LLC
          </h2>
          <div class="mt-6 space-y-4 text-text-body">
            <p>
              歡迎使用 AI Resume Advisor LLC（以下簡稱「我們」或「本公司」）所提供的服務，本公司註冊地址為
              30 N Gould St Ste N Sheridan, WY 82801。本服務條款（以下簡稱「條款」）適用於你使用我們的網站、網頁應用程式、瀏覽器擴充功能及相關服務（統稱「服務」）時所應遵守的條件。
            </p>
            <p>
              當你存取或使用我們的服務，即表示你同意受本條款約束。如果你不同意本條款，請勿使用我們的服務。
            </p>
          </div>
        </section>

        <!-- Section 2 -->
        <section class="rounded-2xl bg-white p-8 shadow-sm">
          <h2
            class="flex items-center gap-3 font-display text-xl font-bold text-text-primary md:text-2xl"
          >
            <span
              class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary text-sm font-bold text-white"
              >2</span
            >
            服務說明
          </h2>
          <div class="mt-6 space-y-4 text-text-body">
            <p>AI Resume Advisor LLC 提供以下服務：</p>
            <div class="mt-4 grid gap-4 md:grid-cols-2">
              <div class="rounded-xl border border-gray-100 bg-gray-50 p-4">
                <h3 class="font-semibold text-text-primary">職缺與履歷匹配分析</h3>
                <p class="mt-2 text-sm">
                  我們的 AI 會分析職缺描述與你的履歷，計算匹配分數與關鍵字涵蓋率。
                </p>
              </div>
              <div class="rounded-xl border border-gray-100 bg-gray-50 p-4">
                <h3 class="font-semibold text-text-primary">落差識別</h3>
                <p class="mt-2 text-sm">
                  我們會識別表達落差（技能未被有效呈現）與技能落差（需要發展的技能）。
                </p>
              </div>
              <div class="rounded-xl border border-gray-100 bg-gray-50 p-4">
                <h3 class="font-semibold text-text-primary">AI 驅動優化</h3>
                <p class="mt-2 text-sm">
                  我們的 AI 會改寫你的履歷，以雇主偏好的語言更好地展現你的經歷。
                </p>
              </div>
              <div class="rounded-xl border border-gray-100 bg-gray-50 p-4">
                <h3 class="font-semibold text-text-primary">技能發展建議</h3>
                <p class="mt-2 text-sm">
                  我們會推薦課程與認證，並提供學習指引，說明該學什麼以及其重要程度。
                </p>
              </div>
              <div class="rounded-xl border border-gray-100 bg-gray-50 p-4">
                <h3 class="font-semibold text-text-primary">職缺匹配模擬器</h3>
                <p class="mt-2 text-sm">
                  在履歷中新增技能，即時查看匹配分數的變化。
                </p>
              </div>
              <div class="rounded-xl border border-gray-100 bg-gray-50 p-4">
                <h3 class="font-semibold text-text-primary">職涯評估報告</h3>
                <p class="mt-2 text-sm">
                  詳細報告包含優勢、劣勢、速效改善建議，以及個人化的推薦。
                </p>
              </div>
              <div class="rounded-xl border border-gray-100 bg-gray-50 p-4">
                <h3 class="font-semibold text-text-primary">瀏覽器擴充功能</h3>
                <p class="mt-2 text-sm">
                  直接在 LinkedIn 網站上分析職缺，即時取得匹配分數與關鍵字涵蓋率。
                </p>
              </div>
            </div>
          </div>
        </section>

        <!-- Section 3 -->
        <section class="rounded-2xl bg-white p-8 shadow-sm">
          <h2
            class="flex items-center gap-3 font-display text-xl font-bold text-text-primary md:text-2xl"
          >
            <span
              class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary text-sm font-bold text-white"
              >3</span
            >
            使用者註冊與帳號
          </h2>
          <div class="mt-6 text-text-body">
            <ul class="space-y-3">
              <li class="flex items-start gap-3">
                <span
                  class="mt-1 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-primary-light text-xs font-medium text-primary"
                  >a</span
                >
                <span>你必須年滿 18 歲才能使用我們的服務。</span>
              </li>
              <li class="flex items-start gap-3">
                <span
                  class="mt-1 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-primary-light text-xs font-medium text-primary"
                  >b</span
                >
                <span>你需要註冊帳號才能使用服務的部分功能。</span>
              </li>
              <li class="flex items-start gap-3">
                <span
                  class="mt-1 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-primary-light text-xs font-medium text-primary"
                  >c</span
                >
                <span
                  >你有責任維護帳號安全，包括妥善保管你的密碼。</span
                >
              </li>
              <li class="flex items-start gap-3">
                <span
                  class="mt-1 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-primary-light text-xs font-medium text-primary"
                  >d</span
                >
                <span
                  >你同意提供準確、完整且最新的註冊資訊。</span
                >
              </li>
            </ul>
          </div>
        </section>

        <!-- Section 4 -->
        <section class="rounded-2xl bg-white p-8 shadow-sm">
          <h2
            class="flex items-center gap-3 font-display text-xl font-bold text-text-primary md:text-2xl"
          >
            <span
              class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary text-sm font-bold text-white"
              >4</span
            >
            使用者責任與行為規範
          </h2>
          <div class="mt-6 text-text-body">
            <p class="mb-4">使用我們的服務時，你同意：</p>
            <ul class="space-y-3">
              <li class="flex items-start gap-3">
                <span
                  class="mt-1 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-primary-light text-xs font-medium text-primary"
                  >a</span
                >
                <span>不違反任何適用的法律或法規。</span>
              </li>
              <li class="flex items-start gap-3">
                <span
                  class="mt-1 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-primary-light text-xs font-medium text-primary"
                  >b</span
                >
                <span>不侵犯他人的智慧財產權或其他權利。</span>
              </li>
              <li class="flex items-start gap-3">
                <span
                  class="mt-1 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-primary-light text-xs font-medium text-primary"
                  >c</span
                >
                <span
                  >不上傳含有病毒、惡意程式碼或其他有害內容的資料。</span
                >
              </li>
              <li class="flex items-start gap-3">
                <span
                  class="mt-1 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-primary-light text-xs font-medium text-primary"
                  >d</span
                >
                <span
                  >不從事可能損害服務或影響其他使用者體驗的行為。</span
                >
              </li>
            </ul>
          </div>
        </section>

        <!-- Section 5 - Browser Extension Usage -->
        <section class="rounded-2xl bg-white p-8 shadow-sm">
          <h2
            class="flex items-center gap-3 font-display text-xl font-bold text-text-primary md:text-2xl"
          >
            <span
              class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary text-sm font-bold text-white"
              >5</span
            >
            瀏覽器擴充功能使用規範
          </h2>
          <div class="mt-6 text-text-body">
            <p class="mb-4">使用我們的 Chrome Extension 時，你另外同意：</p>
            <ul class="space-y-3">
              <li class="flex items-start gap-3">
                <span
                  class="mt-1 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-primary-light text-xs font-medium text-primary"
                  >a</span
                >
                <span>僅將擴充功能用於個人求職目的。</span>
              </li>
              <li class="flex items-start gap-3">
                <span
                  class="mt-1 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-primary-light text-xs font-medium text-primary"
                  >b</span
                >
                <span>不使用自動化工具或腳本大量分析職缺。</span>
              </li>
              <li class="flex items-start gap-3">
                <span
                  class="mt-1 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-primary-light text-xs font-medium text-primary"
                  >c</span
                >
                <span>使用擴充功能時遵守 LinkedIn 的服務條款。</span>
              </li>
              <li class="flex items-start gap-3">
                <span
                  class="mt-1 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-primary-light text-xs font-medium text-primary"
                  >d</span
                >
                <span
                  >授予擴充功能所需的權限（storage、activeTab、scripting、identity），以確保功能正常運作。</span
                >
              </li>
            </ul>
            <div class="mt-6 rounded-xl border border-gray-200 bg-gray-50 p-4">
              <h3 class="font-semibold text-text-primary">使用量限制</h3>
              <p class="mt-2 text-sm text-text-body">
                擴充功能設有合理的使用量限制，依帳號類型而異。目前的限制會顯示在擴充功能中，我們可能會調整限制以維持所有使用者的服務品質。
              </p>
            </div>
            <p class="mt-4 text-sm text-text-caption">
              我們保留對違反本條款或濫用服務的使用者，限制或暫停其擴充功能存取權的權利。
            </p>
          </div>
        </section>

        <!-- Section 6 -->
        <section class="rounded-2xl bg-white p-8 shadow-sm">
          <h2
            class="flex items-center gap-3 font-display text-xl font-bold text-text-primary md:text-2xl"
          >
            <span
              class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary text-sm font-bold text-white"
              >6</span
            >
            智慧財產權與使用者內容
          </h2>
          <div class="mt-6 space-y-4 text-text-body">
            <p>
              <strong>我們的財產：</strong>我們的服務，包括所有相關智慧財產權，均為 AI Resume Advisor LLC 所有。
            </p>
            <p>
              <strong>你的內容：</strong>你完全保有上傳至我們服務的內容的所有權與控制權，包括你的履歷和個人資訊。使用我們的服務即表示你授予我們有限的許可，得以儲存、處理和分析你的內容，僅限於為你提供和改善服務之目的。
            </p>
            <p>
              未經你明確同意，我們不會將你的個人資訊或履歷內容用於任何其他用途。你可以隨時從我們的服務中刪除你的內容。
            </p>
          </div>
        </section>

        <!-- Section 7 -->
        <section class="rounded-2xl bg-white p-8 shadow-sm">
          <h2
            class="flex items-center gap-3 font-display text-xl font-bold text-text-primary md:text-2xl"
          >
            <span
              class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary text-sm font-bold text-white"
              >7</span
            >
            隱私與資料處理
          </h2>
          <div class="mt-6 text-text-body">
            <p>
              我們重視你的隱私。關於我們如何蒐集、使用和保護你的個人資訊，請參閱我們的<a
                href="/zh-TW/privacy"
                class="font-medium text-primary hover:text-primary-hover">隱私權政策</a
              >。
            </p>
          </div>
        </section>

        <!-- Section 8 - Pricing -->
        <section class="rounded-2xl bg-white p-8 shadow-sm">
          <h2
            class="flex items-center gap-3 font-display text-xl font-bold text-text-primary md:text-2xl"
          >
            <span
              class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary text-sm font-bold text-white"
              >8</span
            >
            付款與訂閱
          </h2>
          <div class="mt-6 space-y-6 text-text-body">
            <p>我們提供免費與付費服務：</p>
            <div class="grid gap-4 md:grid-cols-3">
              <div class="rounded-xl border-2 border-gray-200 p-4 text-center">
                <p class="text-2xl font-bold text-text-primary">免費</p>
                <p class="text-sm text-text-caption">每日 5 個職位</p>
                <p class="mt-2 text-xs text-text-body">每天可分析和優化最多 5 個職位</p>
              </div>
              <div class="rounded-xl border-2 border-gray-200 p-4 text-center">
                <p class="text-2xl font-bold text-text-primary">$6</p>
                <p class="text-sm text-text-caption">日票（24 小時）</p>
                <p class="mt-2 text-xs text-text-body">無限制使用</p>
              </div>
              <div class="rounded-xl border-2 border-primary bg-primary-light p-4 text-center">
                <p class="text-2xl font-bold text-primary">$20</p>
                <p class="text-sm text-text-caption">週票（7 天）</p>
                <p class="mt-2 text-xs font-medium text-primary">最划算 - 省下超過 50%</p>
              </div>
            </div>
            <ul class="mt-4 space-y-2 text-sm">
              <li>
                付款由 Stripe 處理。使用我們的付費服務即表示你同意 Stripe 的服務條款。
              </li>
              <li>
                訂閱不會自動續訂。每張票券到期後即失效。
              </li>
              <li>
                退款政策：購買後 24 小時內且尚未使用服務，可申請退款。退款將扣除不可退還的手續費：日票 $0.50、週票 $1.00。一旦已產生任何分析或報告，購買即為最終交易，不予退款。如需申請退款，請聯繫 wenhao@airesumeadvisor.com。
              </li>
            </ul>
          </div>
        </section>

        <!-- Section 9-13 -->
        <section class="rounded-2xl bg-white p-8 shadow-sm">
          <h2
            class="flex items-center gap-3 font-display text-xl font-bold text-text-primary md:text-2xl"
          >
            <span
              class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary text-sm font-bold text-white"
              >9</span
            >
            終止服務
          </h2>
          <div class="mt-6 text-text-body">
            <p>
              我們保留因任何原因隨時終止或暫停你使用服務的權利，包括但不限於違反本條款。
            </p>
          </div>
        </section>

        <section class="rounded-2xl bg-white p-8 shadow-sm">
          <h2
            class="flex items-center gap-3 font-display text-xl font-bold text-text-primary md:text-2xl"
          >
            <span
              class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary text-sm font-bold text-white"
              >10</span
            >
            免責聲明與責任限制
          </h2>
          <div class="mt-6 space-y-4 text-text-body">
            <p>我們的服務以「現狀」提供，不提供任何明示或默示的保證。</p>
            <p>
              在法律允許的最大範圍內，AI Resume Advisor LLC 不對任何直接、間接、附帶、特殊或衍生的損害承擔責任。
            </p>
          </div>
        </section>

        <section class="rounded-2xl bg-white p-8 shadow-sm">
          <h2
            class="flex items-center gap-3 font-display text-xl font-bold text-text-primary md:text-2xl"
          >
            <span
              class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary text-sm font-bold text-white"
              >11</span
            >
            爭議解決與準據法
          </h2>
          <div class="mt-6 text-text-body">
            <ul class="space-y-3">
              <li class="flex items-start gap-3">
                <span
                  class="mt-1 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-primary-light text-xs font-medium text-primary"
                  >a</span
                >
                <span>本條款受美國懷俄明州法律管轄。</span>
              </li>
              <li class="flex items-start gap-3">
                <span
                  class="mt-1 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-primary-light text-xs font-medium text-primary"
                  >b</span
                >
                <span>任何爭議應先透過友善協商解決。</span>
              </li>
              <li class="flex items-start gap-3">
                <span
                  class="mt-1 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-primary-light text-xs font-medium text-primary"
                  >c</span
                >
                <span
                  >若無法達成協議，爭議將提交至懷俄明州法院處理。</span
                >
              </li>
            </ul>
          </div>
        </section>

        <section class="rounded-2xl bg-white p-8 shadow-sm">
          <h2
            class="flex items-center gap-3 font-display text-xl font-bold text-text-primary md:text-2xl"
          >
            <span
              class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary text-sm font-bold text-white"
              >12</span
            >
            條款修改
          </h2>
          <div class="mt-6 text-text-body">
            <p>
              我們可能會不定期修改本條款。修改後的條款將公告於網站上，並於公告時立即生效。你在條款變更後繼續使用我們的服務，即視為同意修改後的條款。
            </p>
          </div>
        </section>

        <section class="rounded-2xl bg-white p-8 shadow-sm">
          <h2
            class="flex items-center gap-3 font-display text-xl font-bold text-text-primary md:text-2xl"
          >
            <span
              class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary text-sm font-bold text-white"
              >13</span
            >
            聯絡我們
          </h2>
          <div class="mt-6 text-text-body">
            <p>如果你對本條款有任何疑問，歡迎透過以下方式聯絡我們：</p>
            <a
              href="mailto:wenhao@airesumeadvisor.com"
              class="mt-4 inline-flex items-center gap-2 font-medium text-primary hover:text-primary-hover"
            >
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                ></path>
              </svg>
              wenhao@airesumeadvisor.com
            </a>
          </div>
        </section>

        <!-- Footer Note -->
        <div class="rounded-2xl bg-primary-light p-6 text-center">
          <p class="text-sm text-primary">
            使用我們的服務即表示你已閱讀、理解並同意受本條款約束。
          </p>
        </div>
      </div>
    </div>
  </main>

  <Footer lang={lang} />
</Layout>
